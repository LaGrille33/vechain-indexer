# Copy this file to .env to use testnet configuration.

SPRING_PROFILES_ACTIVE=indexer,nfts,transactions,transfers,vevote-results,b3tr,explorer,accounts,vevote-historic-proposals,contracts,safe

# Mongo
# MONGO_URI=mongodb://indexer:password@localhost:27017/vechain?authSource=admin
MONGO_URI=mongodb://indexer:password@localhost:27018/vechain?authSource=admin

# Thor
# THOR_URL=https://testnet.vechain.org
# THOR_URL=http://localhost:8669
THOR_URL=https://vebetterdaothortest.smartcarbonlink.com

# Start blocks
INDEXER_START_BLOCK_NFTS=0
INDEXER_START_BLOCK_NFT_BLACKLIST=0
INDEXER_START_BLOCK_TRANSACTIONS=0
INDEXER_START_BLOCK_TRANSFERS=0
INDEXER_START_BLOCK_HISTORY=0
