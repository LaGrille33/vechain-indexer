INDEXER_START_BLOCK_SAFE_TX_STATE=0
INDEXER_START_BLOCK_SAFE_TX_PROPOSALS=0

# Blacklist
BLACKLIST_CONTRACT_ADDRESS=0x9405c18c384dd448f82c11136e188a147186ea3a

# Historic proposals
STEERING_COMMITTEE_ADDRESS=0x7E54f0790153647Ec0651c35cEd28171Adb5D44A
ALL_STAKEHOLDERS_ADDRESS=0xA6416A72F816d3a69f33D0814700545C8E3fe4BE

# Sync block batch sizes
INDEXER_SYNC_BLOCK_BATCH_SIZE_CONTRACTS=125
INDEXER_SYNC_BLOCK_BATCH_SIZE_VET_BALANCE=125
INDEXER_SYNC_BLOCK_BATCH_SIZE_NFTS=125
INDEXER_SYNC_BLOCK_BATCH_SIZE_TRANSFERS=25
INDEXER_SYNC_BLOCK_BATCH_SIZE_VEVOTE=125
INDEXER_SYNC_BLOCK_BATCH_SIZE_STARGATE=125
