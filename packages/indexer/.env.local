INDEXER_SYNC_BLOCK_BATCH_SIZE_B3TR_CHALLENGES=100
INDEXER_SYNC_BLOCK_BATCH_SIZE_B3TR_USER_CHALLENGES=100
INDEXER_SYNC_BLOCK_BATCH_SIZE_B3TR_BALANCE=100

# Channel / checkpoint
INDEXER_CHANNEL_BATCH_SIZE=3
INDEXER_CHECKPOINT_SAVE_INTERVAL_SECONDS=60

# Logging
INDEXER_SYNC_LOG_INTERVAL=10
APP_LOG_LEVEL=INFO
TIMING_LOG_LEVEL=INFO
PRUNER_LOG_LEVEL=INFO
MONGO_DRIVER_LOG_LEVEL=INFO
TIMING_WARN_THRESHOLD_MS=1000
TIMING_VERY_SLOW_THRESHOLD_MS=10000

# Healthcheck
HEALTHCHECK_INACTIVE_THRESHOLD_SYNCING=120
HEALTHCHECK_INACTIVE_THRESHOLD_NOT_SYNCING=600
HEALTHCHECK_REPORT_INTERVAL_MS=10000

# Comments
MIN_COMMENT_LEN=10
LANGUAGE_CONFIDENCE=0.9

